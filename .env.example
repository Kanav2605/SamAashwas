# CivicSense AI / SamAashwas Environment Configuration
APP_NAME="CivicSense AI - SamAashwas"
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# PostGIS / PostgreSQL (Optional, falls back to high-performance spatial in-memory store)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicsense

# AI Model Configuration
NLP_MODEL_BACKEND=rule_hybrid # Options: rule_hybrid, gemini, huggingface
VISION_MODEL_BACKEND=civic_heuristic # Options: civic_heuristic, yolov8, clip
DEDUPLICATION_RADIUS_METERS=300.0
DEDUPLICATION_SIMILARITY_THRESHOLD=0.82

# External APIs
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
GEMINI_API_KEY=
